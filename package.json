{
  "name": "code-harness",
  "version": "1.0.0",
  "description": "Centralized structural code quality governance — evaluate, evolve, verify",
  "type": "module",
  "bin": {
    "code-harness": "./bin/cli.js"
  },
  "scripts": {
    "evaluate": "node bin/cli.js evaluate",
    "evolve": "node bin/cli.js evolve",
    "run-all": "node bin/run-all.js",
    "test": "node --test tests/scorer.test.js tests/scanner.test.js",
    "cron:validate": "node scripts/validate-cron-rules.mjs",
    "cron:status": "node scripts/cron-status-report.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  }
}
